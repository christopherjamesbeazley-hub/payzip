# Add these in Netlify: Site configuration → Environment variables.
# Redeploy after any change (Deploys → Trigger deploy).
#
# TEST: sk_test_... and the sandbox webhook's whsec_...
# LIVE: sk_live_... (or a restricted rk_live_... key, see README) and the
#       LIVE webhook's whsec_... — test and live secrets are different.

STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Optional. Leave unset if you don't use Mollie; its button disappears.
MOLLIE_API_KEY=

# Which provider a plain link uses when it doesn't say: stripe, mollie or tikkie
DEFAULT_PROVIDER=stripe

# Optional: every order event is POSTed here as JSON (Make, Zapier, n8n ...)
# Includes "paid" (Stripe/Mollie) and "awaiting_confirmation" (Tikkie).
FULFILMENT_WEBHOOK_URL=
