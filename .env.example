# Add these in Netlify: Site configuration → Environment variables.
# Start with TEST keys. Swap to live keys only when a test payment works end to end.

STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
MOLLIE_API_KEY=test_...

# Which provider a link uses when it doesn't say: "mollie" or "stripe"
DEFAULT_PROVIDER=mollie

# Optional: every confirmed payment is POSTed here as JSON (Make, Zapier, n8n ...)
FULFILMENT_WEBHOOK_URL=
