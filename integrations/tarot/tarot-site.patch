+import test from 'node:test';
+import assert from 'node:assert/strict';
+import endpoint from '../netlify/functions/paid-reading.js';
+test('checkout binds a paid draw to its originating browser', async t => {
+  Object.assign(process.env, { TAROT_PRICE_CENTS: '300', TAROT_STRIPE_READ_KEY: 'mock',
+    SUPABASE_URL: 'https://db.invalid', SUPABASE_SERVICE_ROLE_KEY: 'mock', PAYZIP_ORIGIN: 'https://checkout.invalid' });
+  const start = await endpoint.handler({ httpMethod: 'GET', headers: {}, queryStringParameters: { start: '1' } });
+  assert.equal(start.statusCode, 303);
+  const owner = new URL(start.headers.Location).searchParams.get('ref');
+  const request = { httpMethod: 'POST', headers: { cookie: start.headers['Set-Cookie'].split(';')[0] }, queryStringParameters: { session_id: 'cs_test_123' } };
+  const session = { id: 'cs_test_123', client_reference_id: owner, metadata: { productId: 'tarot-reading', quantity: '1' },
+    mode: 'payment', currency: 'eur', amount_total: 300, status: 'complete', payment_status: 'unpaid' };
+  let writes = 0;
+  t.mock.method(globalThis, 'fetch', async url => {
+    if (String(url).includes('stripe.com')) return Response.json(session);
+    writes++;
+    return Response.json({id:'major-00',reversed:false});
+  });
+  assert.equal((await endpoint.handler(request)).statusCode, 409);
+  session.payment_status = 'paid';
+  session.amount_total = 50;
+  assert.equal((await endpoint.handler(request)).statusCode, 403);
+  session.amount_total = 300;
+  const foreign = { ...request, headers: {cookie: '__Host-tarot-owner=' + 'a'.repeat(64)} };
+  assert.equal((await endpoint.handler(foreign)).statusCode, 403);
+  assert.equal(writes, 0);
+  assert.deepEqual(JSON.parse((await endpoint.handler(request)).body), {id:'major-00',reversed:false});
+  assert.equal(writes, 1);
+});
