+++ b/netlify/functions/paid-reading.js
@@ -0,0 +1,47 @@
+const { randomBytes, randomInt, createHash } = require('node:crypto');
+const { cards } = require('../../data/cards.json');
+const headers = { 'Cache-Control': 'no-store', 'Content-Type': 'application/json' };
+const reply = (statusCode, error) => ({ statusCode, headers, body: JSON.stringify({error}) });
+const cookieName = '__Host-tarot-owner';
+
+exports.handler = async event => {
+  const env = process.env;
+  const price = Number(env.TAROT_PRICE_CENTS);
+  if (!env.TAROT_STRIPE_READ_KEY || !env.SUPABASE_URL || !env.SUPABASE_SERVICE_ROLE_KEY ||
+      !Number.isSafeInteger(price) || price < 50 || !env.PAYZIP_ORIGIN)
+    return reply(503, 'Paid readings are awaiting configuration.');
+  const cookie = (event.headers.cookie || '').split(';').map(x => x.trim()).find(x => x.startsWith(cookieName + '='));
+  let owner = cookie?.slice(cookieName.length + 1);
+  if (!/^[a-f0-9]{64}$/.test(owner || '')) owner = null;
+  const reference = (value, cents) => cents + '.' + createHash('sha256').update(value + ':' + cents).digest('hex');
+  if (event.httpMethod === 'GET' && event.queryStringParameters?.start === '1') {
+    owner ||= randomBytes(32).toString('hex');
+    const url = new URL('/api/checkout', env.PAYZIP_ORIGIN);
+    url.search = new URLSearchParams({ product: 'tarot-reading', provider: 'stripe', ref: reference(owner, price) });
+    return { statusCode: 303, headers: { ...headers, Location: url.href,
+      'Set-Cookie': cookieName + '=' + owner + '; Path=/; HttpOnly; Secure; SameSite=Lax; Max-Age=31536000' }, body: '' };
+  }
+  if (event.httpMethod !== 'POST') return reply(405, 'Use POST.');
+  if (!owner) return reply(403, 'Open the reading in the browser used for checkout.');
+  const id = event.queryStringParameters?.session_id || '';
+  if (!/^cs_(test|live)_[a-zA-Z0-9]+$/.test(id)) return reply(400, 'Invalid checkout reference.');
+  try {
+    const session = await fetch('https://api.stripe.com/v1/checkout/sessions/' + id,
+      { headers: { Authorization: 'Bearer ' + env.TAROT_STRIPE_READ_KEY }, signal: AbortSignal.timeout(8000) });
+    if (!session.ok) return reply(session.status === 404 ? 404 : 503, 'Unable to verify this checkout.');
+    const s = await session.json();
+    if (s.id !== id || s.client_reference_id !== reference(owner, s.amount_total) || s.metadata?.productId !== 'tarot-reading' ||
+        s.metadata.quantity !== '1' || s.mode !== 'payment' || s.currency !== 'eur' || !Number.isSafeInteger(s.amount_total) || s.amount_total < 50)
+      return reply(403, 'This checkout does not match this reading.');
+    if (s.status !== 'complete' || s.payment_status !== 'paid') return reply(409, 'Payment is pending. Refresh after confirmation.');
+    const database = await fetch(new URL('/rest/v1/rpc/claim_tarot_draw', env.SUPABASE_URL), {
+      method: 'POST', headers: { apikey: env.SUPABASE_SERVICE_ROLE_KEY, Authorization: 'Bearer ' + env.SUPABASE_SERVICE_ROLE_KEY,
+        'Content-Type': 'application/json' }, signal: AbortSignal.timeout(8000),
+      body: JSON.stringify({ purchase: id, buyer: reference(owner, s.amount_total), candidate: cards[randomInt(cards.length)].id, flipped: Boolean(randomInt(2)) })
+    });
+    if (!database.ok) throw new Error();
+    const draw = await database.json();
+    if (!cards.some(c => c.id === draw?.id) || typeof draw.reversed !== 'boolean') throw new Error();
+    return { statusCode: 200, headers, body: JSON.stringify(draw) };
+  } catch { return reply(503, 'Your reading could not be loaded. Refresh to try again.'); }
+};
